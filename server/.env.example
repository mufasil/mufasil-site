# Copy to server/.env on the server and fill in. Never commit server/.env.
# From Brevo: SMTP & API, SMTP tab. The login is shown there; the key is the SMTP key you generated.
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=
# A sender verified in Brevo. Best: an address on mufasil.site after authenticating the domain in Brevo.
MAIL_FROM=
MAIL_TO=mufasil.official@gmail.com
PORT=8787
# Who may post to the form. Add http://127.0.0.1:4322 only for local testing.
ALLOWED_ORIGINS=https://mufasil.site,https://www.mufasil.site
# 1 = log the message instead of sending it.
MAIL_DRY_RUN=0
