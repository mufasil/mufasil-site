---
// Mufasil Iqbal's mark: a rounded M, with an i beside it whose dot and shoulder read as a person.
interface Props { class?: string; withName?: boolean }
const { class: className, withName = true } = Astro.props;
---
<span class:list={["brand", className]}>
  <svg class="brand__mark" viewBox="315 241 1014 568" aria-hidden="true">
    <path class="brand__m" d="M329 809Q315 809 315 795V399A75 75 0 0 1 390 324C425 324 452 332 476 351.6L688.5 528L901 351.6C925 332 952 324 987 324A75 75 0 0 1 1062 399V795Q1062 809 1048 809H926Q912 809 912 795V538.5L698 716.1Q688.5 724 679 716.1L465 538.5V795Q465 809 451 809Z" />
    <path class="brand__stem" d="M1118 799V670A197 197 0 0 1 1305 473.3Q1315 473 1315 483V679A130 130 0 0 1 1185 809H1128Q1118 809 1118 799Z" />
    <circle class="brand__dot" cx="1228" cy="342" r="101" />
  </svg>
  {withName && <span class="brand__name">Mufasil Iqbal</span>}
</span>
