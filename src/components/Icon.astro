const linkedinPath =
  "M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45ZM22.23 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z";

const key = "si" + name.charAt(0).toUpperCase() + name.slice(1);
const brand = (brands as Record<string, { path: string; title: string } | undefined>)[key];
const a11y = label ? { role: "img", "aria-label": label } : { "aria-hidden": "true" };
---
{name === "linkedin" ? (
  <svg class={className} width={size} height={size} viewBox="0 0 24 24" fill="currentColor" {...a11y}><path d={linkedinPath} /></svg>
) : name === "aws" ? (
  <svg class={className} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" {...a11y} set:html={ui.cloud} />
) : ui[name] ? (
  <svg class={className} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={stroke} stroke-linecap="round" stroke-linejoin="round" {...a11y} set:html={ui[name]} />
) : brand ? (
  <svg class={className} width={size} height={size} viewBox="0 0 24 24" fill="currentColor" {...a11y}><path d={brand.path} /></svg>
) : null}
