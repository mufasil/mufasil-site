---
import fs from "node:fs";
import path from "node:path";
import { SITE } from "../consts";

interface Props {
  title: string;
  description: string;
  type?: "website" | "article" | "profile";
  image?: string;
  published?: Date;
  updated?: Date;
  schema?: Record<string, unknown>[];
  noindex?: boolean;
  tags?: string[];
}

const { title, description, type = "website", image, published, updated, schema = [], noindex = false, tags = [] } = Astro.props;
// Each page has its own share image in /og/, generated by .hallmark/og.mjs. Falls back to the home image.
const slug = Astro.url.pathname.replace(/^\/|\/$/g, "").replace(/\//g, "-") || "home";
const generated = `/og/${slug}.png`;
const autoImage = fs.existsSync(path.join(process.cwd(), "public", generated)) ? generated : "/og/home.png";
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const ogImage = new URL(image ?? autoImage, SITE.url).href;
const suffixed = `${title} | ${SITE.name}`;
const fullTitle = title === SITE.title || suffixed.length > 62 ? title : suffixed;

const person = {
  "@type": "Person",
  "@id": `${SITE.url}/#person`,
  name: SITE.name,
  url: `${SITE.url}/`,
  image: `${SITE.url}/mufasil-iqbal.jpg`,
  description: "Senior backend engineer and Technical Team Lead in Karachi, working in Node.js, NestJS and AWS since 2014.",
  email: `mailto:${SITE.email}`,
  jobTitle: SITE.role,
  worksFor: { "@type": "Organization", name: "Social Champ Inc." },
  address: { "@type": "PostalAddress", addressLocality: SITE.city, addressCountry: "PK" },
  alumniOf: { "@type": "CollegeOrUniversity", name: "Dadabhoy Institute of Higher Education" },
  hasCredential: {
    "@type": "EducationalOccupationalCredential",
    name: "AWS Certified Solutions Architect, Associate",
    credentialCategory: "certification",
    recognizedBy: { "@type": "Organization", name: "Amazon Web Services" },
    url: SITE.credly,
  },
  knowsAbout: ["Node.js", "NestJS", "Next.js", "TypeScript", "Amazon Web Services", "PostgreSQL", "MongoDB", "Redis", "Laravel", "Python", "Software architecture", "Engineering leadership"],
  sameAs: [SITE.linkedin, SITE.credly],
};

const website = {
  "@type": "WebSite",
  "@id": `${SITE.url}/#website`,
  url: `${SITE.url}/`,
  name: SITE.name,
  description: SITE.description,
  inLanguage: "en",
  publisher: { "@id": `${SITE.url}/#person` },
};

// Inner pages get a breadcrumb trail unless the page already supplies one.
const hasCrumbs = schema.some((s) => s["@type"] === "BreadcrumbList");
const crumbs = Astro.url.pathname !== "/" && !hasCrumbs && !noindex
  ? [{
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: `${SITE.url}/` },
        { "@type": "ListItem", position: 2, name: title, item: canonical },
      ],
    }]
  : [];

const graph = { "@context": "https://schema.org", "@graph": [person, website, ...schema, ...crumbs] };
---
<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex" />}
<meta name="author" content={SITE.name} />
<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={fullTitle} />
<meta property="og:locale" content="en_GB" />
{published && <meta property="article:published_time" content={published.toISOString()} />}
{updated && <meta property="article:modified_time" content={updated.toISOString()} />}
{type === "article" && <meta property="article:author" content={SITE.linkedin} />}
{tags.map((t) => <meta property="article:tag" content={t} />)}
<meta name="twitter:image:alt" content={fullTitle} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<script type="application/ld+json" set:html={JSON.stringify(graph)} />
