---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { SITE } from "../../consts";
import { Image } from "astro:assets";
import Icon from "../../components/Icon.astro";
import PageHero from "../../components/PageHero.astro";
import ContactCta from "../../components/ContactCta.astro";
import cutout from "../../assets/mufasil-cutout.png";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const toc = headings.filter((h) => h.depth === 2);
const more = (await getCollection("blog")).filter((p) => p.id !== entry.id).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 2);
const url = `${SITE.url}/blog/${entry.id}/`;
const fmt = (d: Date) => d.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" });
const words = (entry.body ?? "").split(/\s+/).filter(Boolean).length;
const minutes = Math.max(1, Math.round(words / 220));

const schema = [
  {
    "@type": "BlogPosting",
    "@id": `${url}#post`,
    headline: entry.data.title,
    description: entry.data.description,
    url,
    mainEntityOfPage: url,
    datePublished: entry.data.pubDate.toISOString(),
    dateModified: (entry.data.updated ?? entry.data.pubDate).toISOString(),
    author: { "@id": `${SITE.url}/#person` },
    publisher: { "@id": `${SITE.url}/#person` },
    image: `${SITE.url}/og/blog-${entry.id}.png`,
    keywords: entry.data.tags.join(", "),
    wordCount: words,
    inLanguage: "en",
  },
  {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${SITE.url}/` },
      { "@type": "ListItem", position: 2, name: "Writing", item: `${SITE.url}/blog/` },
      { "@type": "ListItem", position: 3, name: entry.data.title, item: url },
    ],
  },
];
---
<Base title={entry.data.title} description={entry.data.description} type="article" published={entry.data.pubDate} updated={entry.data.updated} schema={schema} tags={entry.data.tags}>
  <PageHero size="md" crumbs={[{ href: "/", label: "Home" }, { href: "/blog/", label: "Writing" }, { label: entry.data.tags[0] ?? "Note" }]} title={entry.data.title} lead={entry.data.description}>
    <div class="byline">
      <span class="byline__avatar"><Image src={cutout} alt="Mufasil Iqbal" widths={[96]} sizes="48px" /></span>
      <div>
        <b>Mufasil Iqbal</b>
        <p class="post-meta"><time datetime={entry.data.pubDate.toISOString()}>{fmt(entry.data.pubDate)}</time><span>{minutes} min read</span></p>
      </div>
    </div>
    <ul class="tags">{entry.data.tags.map((t) => <li>{t}</li>)}</ul>
  </PageHero>

  <div class="wrap article">
    <article class="prose prose--post" data-code-copy>
      <Content />
    </article>
    <aside class="aside" aria-label="On this page">
      {toc.length > 1 && (
        <nav class="toc card">
          <p class="aside__label">On this page</p>
          <ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
        </nav>
      )}
      <div class="card author">
        <p class="aside__title">Need this done on your app?</p>
        <p>I’m a Node.js and AWS engineering lead, and I take AI-built apps to production.</p>
        <a class="btn btn--pill btn--primary" href="/contact/?type=consulting">Write to me <span class="btn__dot"><Icon name="arrowUpRight" size={14} /></span></a>
      </div>
    </aside>
  </div>

  {more.length > 0 && (
    <section class="section section--band">
      <div class="wrap">
        <div class="section__head" data-reveal>
          <p class="kicker">Keep reading</p>
          <h2>More notes from production</h2>
        </div>
        <div class="notes">
          {more.map((post) => (
            <a class="note" href={`/blog/${post.id}/`} data-reveal>
              <p class="post-meta"><time datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time></p>
              <h2>{post.data.title}</h2>
              <p>{post.data.description}</p>
              <div class="note__foot">
                <ul class="tags">{post.data.tags.slice(0, 3).map((t) => <li>{t}</li>)}</ul>
                <span class="case__arrow"><Icon name="arrowUpRight" size={18} /></span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section">
    <div class="wrap"><ContactCta heading="Seeing this on your own app?" text="Send me what you’re seeing and where it runs. I reply by email." /></div>
  </section>
</Base>

<script>
  // Every code block gets a copy button. Without scripting the code is still selectable.
  document.querySelectorAll<HTMLPreElement>("[data-code-copy] pre").forEach((pre) => {
    // The button sits on a wrapper, so it stays put when a long line scrolls sideways.
    const block = document.createElement("div");
    block.className = "code-block";
    pre.replaceWith(block);
    block.append(pre);
    const button = document.createElement("button");
    button.type = "button";
    button.className = "code-copy";
    button.textContent = "Copy";
    button.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText((pre.querySelector("code") ?? pre).textContent ?? "");
        button.textContent = "Copied";
      } catch {
        button.textContent = "Select and copy";
      }
      setTimeout(() => (button.textContent = "Copy"), 1800);
    });
    block.append(button);
  });
</script>
